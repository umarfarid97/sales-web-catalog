# Supabase Cloud Database Configuration
# Replace these with your Supabase Project Settings -> API credentials:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ToyyibPay FPX Gateway Configuration
# Set VITE_TOYYIBPAY_SANDBOX=true for dev.toyyibpay.com or false for live toyyibpay.com
VITE_TOYYIBPAY_SANDBOX=true
VITE_TOYYIBPAY_SECRET_KEY=your-toyyibpay-user-secret-key
VITE_TOYYIBPAY_CATEGORY_CODE=your-toyyibpay-category-code
